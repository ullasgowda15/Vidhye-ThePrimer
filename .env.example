DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=1
DATABASE_URL=postgres://primer:primer@localhost:5432/primer
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI layer -----------------------------------------------------------------
# Which providers the model router tries, in order. The first one that has
# credentials wins. Anthropic is the configured primary; put openrouter first to
# develop against a free model instead.
#   AI_PROVIDER_ORDER=openrouter,anthropic
AI_PROVIDER_ORDER=anthropic

# The beat model, interpreted by whichever provider is selected: a Claude model id
# for anthropic, an OpenRouter model slug for openrouter. Free-model availability on
# OpenRouter changes over time — pick one that is currently listed and supports
# JSON/tool output, e.g. AI_BEAT_MODEL=vendor/model-name:free
AI_BEAT_MODEL=claude-opus-5

# How hard to insist on provider-enforced structured output:
#   auto        try a strict json_schema, fall back to JSON mode + repair (default)
#   strict      require a strict json_schema; error instead of degrading
#   json_object skip straight to JSON mode + repair
# Applies to OpenAI-compatible providers; Anthropic enforces the schema natively.
AI_STRUCTURED_OUTPUT_MODE=auto

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional. Sent to OpenRouter as the HTTP-Referer attribution header.
OPENROUTER_SITE_URL=http://localhost:5173
