{
    "openapi": "3.0.3",
    "info": {
        "title": "The Primer API",
        "version": "0.1.0",
        "description": "The Primer — an AI-generated living storybook and lifelong learning companion for children aged 3-7."
    },
    "paths": {
        "/api/health/": {
            "get": {
                "operationId": "health",
                "description": "Returns 200 while the API process is serving requests.",
                "summary": "Liveness probe",
                "tags": [
                    "health"
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Health"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "operationId": "auth_login",
                "description": "Exchange email + password for an access/refresh pair.\n\n`TokenViewBase` already sets `permission_classes = ()` and\n`authentication_classes = ()`, which is what a credential endpoint needs;\nre-stating them here would only invite someone to \"tidy\" them into the\nproject defaults and lock the login page behind a login.",
                "summary": "Log in",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenObtainPairRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenObtainPairRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenObtainPairRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenObtainPair"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "operationId": "auth_logout",
                "description": "Blacklist a refresh token.",
                "summary": "Log out",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LogoutRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/LogoutRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/LogoutRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Refresh token blacklisted."
                    }
                }
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "operationId": "auth_refresh",
                "description": "Rotate a refresh token.\n\nWith `ROTATE_REFRESH_TOKENS` + `BLACKLIST_AFTER_ROTATION` the response\ncarries a *new* refresh token and the presented one is blacklisted, so the\nclient must replace both halves of the pair, not just the access token.\n\nUnauthenticated by inheritance, as in `LoginView` — the refresh token *is*\nthe credential.",
                "summary": "Rotate tokens",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRefreshRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRefreshRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRefreshRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenRefresh"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/signup": {
            "post": {
                "operationId": "auth_signup",
                "description": "Create a parent account and sign them straight in.",
                "summary": "Create a parent account",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SignupRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/SignupRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/SignupRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignupResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/children": {
            "get": {
                "operationId": "children_list",
                "description": "Narrow a viewset's collection routes to the requesting parent.\n\n`parent_lookup` is the ORM path from the model to the owning parent —\n`\"parent\"` for `Child`, `\"child__parent\"` for anything hanging off a child.\n\nDetail routes deliberately resolve against the *unscoped* queryset so that\n`IsParentOwner` is the thing that rejects them, with a 403. Filtering them\ntoo would give 404 and hide the existence of the row — marginally better\nagainst enumeration, but it would also make an ownership bug indistinguish-\nable from a deleted row in the logs, and it is not what the API promises.\nObject IDs are UUIDs, so there is nothing here to enumerate.",
                "summary": "List this parent's children",
                "tags": [
                    "v1"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Child"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "post": {
                "operationId": "children_create",
                "description": "Requires an active consent record; returns 403 without one.",
                "summary": "Create a child profile",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChildRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ChildRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ChildRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Child"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/children/{id}": {
            "get": {
                "operationId": "children_retrieve",
                "description": "Narrow a viewset's collection routes to the requesting parent.\n\n`parent_lookup` is the ORM path from the model to the owning parent —\n`\"parent\"` for `Child`, `\"child__parent\"` for anything hanging off a child.\n\nDetail routes deliberately resolve against the *unscoped* queryset so that\n`IsParentOwner` is the thing that rejects them, with a 403. Filtering them\ntoo would give 404 and hide the existence of the row — marginally better\nagainst enumeration, but it would also make an ownership bug indistinguish-\nable from a deleted row in the logs, and it is not what the API promises.\nObject IDs are UUIDs, so there is nothing here to enumerate.",
                "summary": "Fetch a child profile",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "A UUID string identifying this child.",
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Child"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "put": {
                "operationId": "children_update",
                "description": "Narrow a viewset's collection routes to the requesting parent.\n\n`parent_lookup` is the ORM path from the model to the owning parent —\n`\"parent\"` for `Child`, `\"child__parent\"` for anything hanging off a child.\n\nDetail routes deliberately resolve against the *unscoped* queryset so that\n`IsParentOwner` is the thing that rejects them, with a 403. Filtering them\ntoo would give 404 and hide the existence of the row — marginally better\nagainst enumeration, but it would also make an ownership bug indistinguish-\nable from a deleted row in the logs, and it is not what the API promises.\nObject IDs are UUIDs, so there is nothing here to enumerate.",
                "summary": "Replace a child profile",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "A UUID string identifying this child.",
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ChildRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ChildRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ChildRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Child"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "patch": {
                "operationId": "children_partial_update",
                "description": "Narrow a viewset's collection routes to the requesting parent.\n\n`parent_lookup` is the ORM path from the model to the owning parent —\n`\"parent\"` for `Child`, `\"child__parent\"` for anything hanging off a child.\n\nDetail routes deliberately resolve against the *unscoped* queryset so that\n`IsParentOwner` is the thing that rejects them, with a 403. Filtering them\ntoo would give 404 and hide the existence of the row — marginally better\nagainst enumeration, but it would also make an ownership bug indistinguish-\nable from a deleted row in the logs, and it is not what the API promises.\nObject IDs are UUIDs, so there is nothing here to enumerate.",
                "summary": "Update a child profile",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "A UUID string identifying this child.",
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedChildRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedChildRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/PatchedChildRequest"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Child"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            },
            "delete": {
                "operationId": "children_destroy",
                "description": "Every table referencing a child cascades from this row (§17.5), so one delete satisfies 'delete my child's data'.",
                "summary": "Delete a child and every row linked to them",
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "A UUID string identifying this child.",
                        "required": true
                    }
                ],
                "tags": [
                    "v1"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/consent": {
            "post": {
                "operationId": "consent_create",
                "description": "Record verifiable parental consent (§13.7).\n\nCreate-only on purpose: consent is an audit trail, so a change of mind is a\nnew record (or a revocation), never an edit of the old one.",
                "summary": "Record parental consent",
                "tags": [
                    "v1"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ConsentRecordRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ConsentRecordRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/ConsentRecordRequest"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConsentRecord"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/me": {
            "get": {
                "operationId": "me",
                "description": "The signed-in parent and their children.",
                "summary": "The signed-in parent",
                "tags": [
                    "v1"
                ],
                "security": [
                    {
                        "jwtAuth": []
                    },
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Me"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Child": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "first_name": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "birthdate": {
                        "type": "string",
                        "format": "date"
                    },
                    "locale": {
                        "type": "string",
                        "maxLength": 16
                    },
                    "pre_reader": {
                        "type": "boolean"
                    },
                    "interests": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Things this child loves, e.g. ['dinosaurs', 'the sea'].",
                        "maxItems": 10
                    },
                    "fears": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Things they are a little scared of. Handled gently, never used as a threat.",
                        "maxItems": 10
                    },
                    "avoid_topics": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Topics never to include. Copied verbatim into the safety layer.",
                        "maxItems": 10
                    },
                    "intensity_ceiling": {
                        "type": "integer",
                        "maximum": 3,
                        "minimum": 0,
                        "description": "0 = gentlest, 3 = most adventurous. An int, never free text."
                    },
                    "session_cap_min": {
                        "type": "integer",
                        "maximum": 30,
                        "minimum": 5,
                        "description": "Minutes per sitting before the story starts winding down (§13.6)."
                    },
                    "age": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "age_band": {
                        "type": "string",
                        "readOnly": true
                    },
                    "age_out_of_range": {
                        "type": "boolean",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "age",
                    "age_band",
                    "age_out_of_range",
                    "birthdate",
                    "created_at",
                    "first_name",
                    "id",
                    "updated_at"
                ]
            },
            "ChildRequest": {
                "type": "object",
                "properties": {
                    "first_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "birthdate": {
                        "type": "string",
                        "format": "date"
                    },
                    "locale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                    },
                    "pre_reader": {
                        "type": "boolean"
                    },
                    "interests": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Things this child loves, e.g. ['dinosaurs', 'the sea'].",
                        "maxItems": 10
                    },
                    "fears": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Things they are a little scared of. Handled gently, never used as a threat.",
                        "maxItems": 10
                    },
                    "avoid_topics": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Topics never to include. Copied verbatim into the safety layer.",
                        "maxItems": 10
                    },
                    "intensity_ceiling": {
                        "type": "integer",
                        "maximum": 3,
                        "minimum": 0,
                        "description": "0 = gentlest, 3 = most adventurous. An int, never free text."
                    },
                    "session_cap_min": {
                        "type": "integer",
                        "maximum": 30,
                        "minimum": 5,
                        "description": "Minutes per sitting before the story starts winding down (§13.6)."
                    }
                },
                "required": [
                    "birthdate",
                    "first_name"
                ]
            },
            "ConsentRecord": {
                "type": "object",
                "description": "Records one verifiable-consent grant.\n\n`parent`, `ip` and `granted_at` are all server-set: a consent record whose\nevidence the client could dictate is not evidence.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "child_ref": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true,
                        "description": "Optional child this grant is scoped to. Usually omitted — consent precedes the child."
                    },
                    "consent_type": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ConsentTypeEnum"
                            }
                        ],
                        "default": "data_collection_v1"
                    },
                    "method": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MethodEnum"
                            }
                        ],
                        "default": "checkbox_attestation"
                    },
                    "granted_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "evidence_ref": {
                        "type": "string",
                        "readOnly": true
                    },
                    "revoked_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true,
                        "nullable": true
                    }
                },
                "required": [
                    "evidence_ref",
                    "granted_at",
                    "id",
                    "revoked_at"
                ]
            },
            "ConsentRecordRequest": {
                "type": "object",
                "description": "Records one verifiable-consent grant.\n\n`parent`, `ip` and `granted_at` are all server-set: a consent record whose\nevidence the client could dictate is not evidence.",
                "properties": {
                    "child_ref": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true,
                        "description": "Optional child this grant is scoped to. Usually omitted — consent precedes the child."
                    },
                    "consent_type": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ConsentTypeEnum"
                            }
                        ],
                        "default": "data_collection_v1"
                    },
                    "method": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/MethodEnum"
                            }
                        ],
                        "default": "checkbox_attestation"
                    }
                }
            },
            "ConsentTypeEnum": {
                "enum": [
                    "data_collection_v1"
                ],
                "type": "string",
                "description": "* `data_collection_v1` - Data collection v1"
            },
            "Health": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    },
                    "service": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    }
                },
                "required": [
                    "service",
                    "status",
                    "version"
                ]
            },
            "LogoutRequest": {
                "type": "object",
                "properties": {
                    "refresh": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The refresh token to blacklist."
                    }
                },
                "required": [
                    "refresh"
                ]
            },
            "Me": {
                "type": "object",
                "description": "The parent as the client sees them. No permission or staff flags leak out.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true
                    },
                    "display_name": {
                        "type": "string",
                        "readOnly": true
                    },
                    "locale": {
                        "type": "string",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Child"
                        },
                        "readOnly": true
                    }
                },
                "required": [
                    "children",
                    "created_at",
                    "display_name",
                    "email",
                    "id",
                    "locale"
                ]
            },
            "MethodEnum": {
                "enum": [
                    "checkbox_attestation"
                ],
                "type": "string",
                "description": "* `checkbox_attestation` - Checkbox attestation"
            },
            "PatchedChildRequest": {
                "type": "object",
                "properties": {
                    "first_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    },
                    "birthdate": {
                        "type": "string",
                        "format": "date"
                    },
                    "locale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                    },
                    "pre_reader": {
                        "type": "boolean"
                    },
                    "interests": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Things this child loves, e.g. ['dinosaurs', 'the sea'].",
                        "maxItems": 10
                    },
                    "fears": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Things they are a little scared of. Handled gently, never used as a threat.",
                        "maxItems": 10
                    },
                    "avoid_topics": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 60
                        },
                        "description": "Topics never to include. Copied verbatim into the safety layer.",
                        "maxItems": 10
                    },
                    "intensity_ceiling": {
                        "type": "integer",
                        "maximum": 3,
                        "minimum": 0,
                        "description": "0 = gentlest, 3 = most adventurous. An int, never free text."
                    },
                    "session_cap_min": {
                        "type": "integer",
                        "maximum": 30,
                        "minimum": 5,
                        "description": "Minutes per sitting before the story starts winding down (§13.6)."
                    }
                }
            },
            "SignupRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "display_name": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "locale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "SignupResponse": {
                "type": "object",
                "description": "Response shape for signup — documented for the generated TS client.",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/User"
                    },
                    "access": {
                        "type": "string"
                    },
                    "refresh": {
                        "type": "string"
                    }
                },
                "required": [
                    "access",
                    "refresh",
                    "user"
                ]
            },
            "TokenObtainPair": {
                "type": "object",
                "properties": {
                    "access": {
                        "type": "string",
                        "readOnly": true
                    },
                    "refresh": {
                        "type": "string",
                        "readOnly": true
                    }
                },
                "required": [
                    "access",
                    "refresh"
                ]
            },
            "TokenObtainPairRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "TokenRefresh": {
                "type": "object",
                "properties": {
                    "access": {
                        "type": "string",
                        "readOnly": true
                    },
                    "refresh": {
                        "type": "string"
                    }
                },
                "required": [
                    "access",
                    "refresh"
                ]
            },
            "TokenRefreshRequest": {
                "type": "object",
                "properties": {
                    "refresh": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "required": [
                    "refresh"
                ]
            },
            "User": {
                "type": "object",
                "description": "The parent as the client sees them. No permission or staff flags leak out.",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "readOnly": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "readOnly": true
                    },
                    "display_name": {
                        "type": "string",
                        "readOnly": true
                    },
                    "locale": {
                        "type": "string",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    }
                },
                "required": [
                    "created_at",
                    "display_name",
                    "email",
                    "id",
                    "locale"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "sessionid"
            },
            "jwtAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}