DJANGO_SETTINGS_MODULE=config.settings.dev
# Also signs JWTs (SIMPLE_JWT.SIGNING_KEY), so give it at least 32 bytes —
# PyJWT warns below that, and a guessable key is a forgeable session.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-at-least-32-random-bytes-before-you-deploy
DEBUG=1
DATABASE_URL=postgres://primer:primer@localhost:5432/primer
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Accounts, consent & limits ------------------------------------------------
# Where the parent app lives. Only used to build the email-verification link,
# which Day 2 logs to the console instead of sending.
FRONTEND_BASE_URL=http://localhost:5173

# The consent version a parent must hold before a child profile can be created
# (§13.7). Bumping this forces everyone to re-consent — which is the point when
# the disclosure materially changes.
REQUIRED_CONSENT_TYPE=data_collection_v1

# Rate limits (§18.2). `auth` is the tighter scope on signup/login/refresh.
THROTTLE_ANON=100/day
THROTTLE_USER=1000/day
THROTTLE_AUTH=30/hour

# --- AI layer -----------------------------------------------------------------
# Which providers the model router tries, in order. The first one that has
# credentials wins. Three are implemented: `google` (Gemini on Vertex AI — what
# this file is configured for and what the pilot deploys, see the next section),
# `anthropic`, and `openrouter` (a gateway, useful for developing against a free
# model). Both alternatives are real seams, kept working and kept switchable:
#   AI_PROVIDER_ORDER=anthropic
#   AI_PROVIDER_ORDER=openrouter,anthropic
#
# The registered name is `google`, **not** `gemini`. Django refuses to start on
# an unknown provider name, which is the good outcome; the bad one is a document
# that says `gemini` and a person who trusts it.
#
# IMPORTANT: AI_BEAT_MODEL *and* AI_SAFETY_MODEL are both interpreted by whichever
# provider wins, so switching this line means switching both of them. Django now
# refuses to start on a mismatch (a Claude model id under openrouter, a slug
# under anthropic or google) rather than letting the safety grader 400 on every
# beat — which is exactly how it failed silently before.
#
# **This file describes ONE deployment.** It used to pre-switch the embedding
# route to Google while the LLM and the image gate stayed on Anthropic, which
# meant copying it verbatim produced a box that could not embed anything — and
# `prod.py` now refuses to boot on exactly that. Every uncommented value below is
# the all-Google deployment `Docs/Hosting.md §4` describes; every Anthropic and
# OpenRouter value is one comment character away.
AI_PROVIDER_ORDER=google

# --- Gemini on Vertex AI (§13.8, Docs/Hosting.md §3) --------------------------
# The all-Google deployment: beats, the safety grader, the memory digest and the
# image-moderation vision call, on one GCP project, billed to the $300 credit.
#
# **Vertex, not AI Studio.** A Vertex call is authenticated by a *service
# account*, billed to the project, and covered by the GCP terms that exclude our
# inputs from model training. The AI Studio free tier trains on prompts, and a
# beat prompt carries the child's first name, age band, avoid list, fears and
# retrieved memories. There is no API-key setting here on purpose.
#
# This is the configuration below, in one place: AI_PROVIDER_ORDER=google,
# AI_BEAT_MODEL=gemini-2.5-flash, AI_SAFETY_MODEL=gemini-2.5-flash-lite (which
# must differ from the beat model), IMAGE_MODERATION_PROVIDER=google,
# IMAGE_MODERATION_MODEL=gemini-2.5-flash-lite, EMBEDDING_PROVIDER=google. Fill in
# the two blanks below and the whole product runs on one service account.
#
# `prod.py` refuses to boot when any of the three routes above names google and
# these settings are not all set — a half-set Vertex box does not crash, it
# quietly serves fallback beats, reports moderation=absent and stores every memory
# with no vector.
#
# GOOGLE_CLOUD_LOCATION is part of the endpoint, so a region that does not serve
# the configured model answers 404 to every call. **Verified against the live
# API, not the docs:** `asia-south1` (Mumbai) serves gemini-2.5-flash but *not*
# gemini-2.5-flash-lite, so it cannot run the safety grader — and `global` and
# `us-central1` serve both. `client.models.get()` reports the model as present in
# asia-south1 and `generate_content` then 404s, so check with a real generation.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Absolute path to the service-account JSON **outside this repository** — e.g.
# ~/.config/primer/vertex-sa.json, owner-read-only. Never commit the key: the
# .gitignore rules for it are a safety net, not the plan.
GOOGLE_APPLICATION_CREDENTIALS=
# Read by the google-genai SDK. The app passes vertexai=True explicitly
# (apps/common/vertex.py), so this is for ad-hoc scripts and CLI tools.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Embeddings: semantic recall, the moat (§11.3, §16.6) ---------------------
# The fourth and last child-data route on Vertex, so the whole product is one
# vendor, one service account, one set of terms (§13.8) — and **no OpenAI
# account is required anywhere**.
#
# `google` is `gemini-embedding-001` on the GOOGLE_CLOUD_* credentials above.
# `openai` (text-embedding-3-small, needs OPENAI_API_KEY) and `local` still work
# and are still selectable; `local` is a *lexical* hashing trick, not a model —
# it makes the vector column, the ANN index and the ordering of a
# nearest-neighbour query exercisable with no key and no spend, and it cannot
# match "the winged reptile he invented" to a memory about a dragon. Every
# consolidation run logs which was used, so a database of lexical vectors is
# never mistaken for a semantic one.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
# The width of `memory.embedding`, and therefore of every vector stored. Changing
# it is a migration plus a re-embed, not a config flip. 1536 is deliberate:
# `gemini-embedding-001` is a Matryoshka model with a native width of 3072 whose
# prefixes are usable embeddings, so it is asked for 1536 and the column and its
# HNSW index are untouched. The provider re-normalizes the truncated vector,
# which is not unit-length as returned (measured 0.690528 at 1536).
EMBEDDING_DIMENSIONS=1536

# The beat model, interpreted by whichever provider is selected: a bare Gemini id
# for google, a Claude model id for anthropic, an OpenRouter model slug for
# openrouter. Change it in step with AI_PROVIDER_ORDER — Django refuses to start
# on a mismatch. The alternatives:
#   AI_BEAT_MODEL=claude-opus-5          (anthropic)
#   AI_BEAT_MODEL=vendor/model-name      (openrouter — must be currently listed
#                                         and support JSON/tool output)
#
# NOT a `:free` route (§13.8). A `:free` OpenRouter variant is the same weights
# under terms that let the gateway log and train on the prompt — and a beat prompt
# carries the child's first name, age band, avoid list, fears and retrieved
# memories. `prod.py` refuses to boot on one and `manage.py launch_check` blocks
# on one, for all four child-data models (beat, safety, memory, embedding). This
# line used to recommend the opposite; the Day 1-15 audit's F-3 is why it does
# not. See Docs/Hosting.md §3.
AI_BEAT_MODEL=gemini-2.5-flash

# How hard to insist on provider-enforced structured output:
#   auto        try a strict json_schema, fall back to JSON mode + repair (default)
#   strict      require a strict json_schema; error instead of degrading
#   json_object skip straight to JSON mode + repair
# Applies to OpenAI-compatible providers; Anthropic enforces the schema natively.
AI_STRUCTURED_OUTPUT_MODE=auto

# Not needed by the configuration above — Vertex is authenticated by the service
# account, not by an API key. These are here for the alternatives: fill one in
# only if you also switch AI_PROVIDER_ORDER (and the model ids) to match it.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional. Sent to OpenRouter as the HTTP-Referer attribution header.
OPENROUTER_SITE_URL=http://localhost:5173

# --- Safety layer (§13.2, §13.3) ----------------------------------------------
# The independent output classifier grades every beat before a child sees it, and
# it must not be the model that wrote the beat (§13.3: "a model grading its own
# output is weak"). Provider-relative, exactly like AI_BEAT_MODEL. Small and fast
# on purpose — grading against a rubric is classification, not writing, and this
# call sits in front of every beat.
#
# Small and fast, NOT weak. This is the layer that reads subtext — the one that
# catches an injection the keyword scrubber cannot see and a beat that is unsafe
# without using an unsafe word. A throwaway free model here buys a few cents and
# spends the product's whole recall story; `apps.safety.policy` says outright that
# recall is this model's job. Pick a capable instruct model.
#
# Change this line whenever you change AI_PROVIDER_ORDER — see the note there:
#   AI_SAFETY_MODEL=claude-haiku-4-5-20251001   (anthropic)
#   AI_SAFETY_MODEL=anthropic/claude-haiku-4.5  (openrouter — a vendor/model slug)
#
# AI_MEMORY_MODEL is not listed separately: it defaults to whatever this is, so
# the memory digest cannot end up on a different provider by being forgotten.
AI_SAFETY_MODEL=gemini-2.5-flash-lite

# Whether that model-backed guard runs at all. The deterministic policy check
# needs no provider and always runs; this switches on the layer above it. Ships
# ON, and prod.py refuses to boot with it off. With no credentials the call fails
# and the pipeline records a *degradation* with an incident row — never a pass.
SAFETY_CLASSIFIER_ENABLED=true

# How many constrained regenerations one beat may cost before the pre-vetted
# fallback beat is served instead. The child is waiting; a third retry buys less
# than the fallback does.
SAFETY_MAX_REWRITES=2

# The image gate (§13.8). `auto` runs a vision moderation call when a provider is
# configured and falls back to structural checks when it is not, logging the gap
# on every scan; `off` is structural-only and is for offline development and CI.
# prod.py refuses to boot on `off`. There is no mode in which bytes reach storage
# unscanned. Needs a vision-capable model and credentials for it.
IMAGE_MODERATION=auto
#   IMAGE_MODERATION_MODEL=claude-haiku-4-5-20251001   (with the provider below
#                                                       set to anthropic or auto)
IMAGE_MODERATION_MODEL=gemini-2.5-flash-lite
# Which vision model runs the gate: `anthropic`, `google`, or `auto`.
#
# It does NOT ride AI_PROVIDER_ORDER — the moderator does not go through the
# router, and the illustrator, the writer and the moderator being three different
# companies is a stronger §13.3 guarantee than one vendor grading itself.
#
# Named rather than left on `auto`: `auto` takes the first provider with
# credentials, Anthropic first, so on a box with an Anthropic key lying around it
# silently runs a different model from the one IMAGE_MODERATION_MODEL names. Say
# which one. `manage.py launch_check` now asks whether a moderator actually
# exists — a gate with no credentials degrades to the structural check and logs
# `moderation=absent` on every scan while the setting still says `auto`, and that
# row used to report OK. Set this to `anthropic` alongside an ANTHROPIC_API_KEY if
# you want a second vendor between the illustrator and the child.
IMAGE_MODERATION_PROVIDER=google

# --- Illustration adapter (§16.6, §5.8) ---------------------------------------
# Which image provider to call. `cloudflare` runs FLUX on Workers AI and is the
# implemented one; `local` draws deterministic offline placeholder art so the
# whole pipeline (hashing, safety scan, storage, cache) can be run with no key
# and no spend. `together`/`openai`/`google` are declared seams that raise.
# A named provider with missing credentials is an error, never a silent
# downgrade to placeholder art.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# flux-1-schnell is a few-step distilled model: 4 is its default, 8 its ceiling.
IMAGE_STEPS=4

# Refuse anything wildly larger than a storybook illustration before it is
# stored — that is a provider bug or a hostile response, not a picture.
MEDIA_MAX_BYTES=12582912

# --- Voice adapter (§16.6, §9.1) ----------------------------------------------
# `elevenlabs` and `google` are implemented; `local` synthesises a short offline
# chime for development. `openai` is a declared seam that raises.
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# The voice every companion speaks in unless it is mapped below. Required:
# ElevenLabs has no default voice of its own.
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 bills 0.5 credits/character; eleven_multilingual_v2 and
# eleven_v3 bill 1.0. On the free 10,000-credit tier that is the difference
# between 20,000 and 10,000 characters of narration a month, and flash is also
# the lowest-latency option. Switch to multilingual_v2 only if you are paying
# and want the extra prosody.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional. Maps a companion's *semantic* voice key — set from its archetype
# (warm_low, bright_young, clear_bright, airy_soft, calm_deep) — to a real
# ElevenLabs voice id, so different archetypes can sound different. Unmapped
# keys fall back to ELEVENLABS_VOICE_ID, so one voice is enough to ship.
#   ELEVENLABS_VOICE_MAP={"warm_low":"21m00Tcm...","calm_deep":"AZnzlk1X..."}
ELEVENLABS_VOICE_MAP={}

# Voice providers to try when TTS_PROVIDER fails, in order. Unlike the image
# side, the voice fails over: a missing picture is a playable beat, a missing
# voice is a screen a pre-reader cannot read and nothing to tap (§4.9). One
# outage — ElevenLabs `quota_exceeded` — is a real 21-second dead screen without
# this. A listed provider with no key is skipped, so leaving GOOGLE_TTS_API_KEY
# empty simply means there is no fallback yet.
#
# Do NOT put `local` here: the offline chime is two notes, not speech, so it
# would hand the child their turn and tell them nothing — and hide the outage.
TTS_FALLBACK_PROVIDERS=google

# Google Cloud Text-to-Speech — the implemented fallback voice, and the free
# option when ElevenLabs runs dry (1M characters a month on the Neural2 tier).
# Create an API key in a Google Cloud project with the Text-to-Speech API
# enabled. The language code is derived from the voice name, so these two cannot
# disagree; GOOGLE_TTS_LANGUAGE_CODE is used only if the voice name is blank.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-F
GOOGLE_TTS_LANGUAGE_CODE=en-US
# Optional, same idea as ELEVENLABS_VOICE_MAP: archetype key -> Google voice.
#   GOOGLE_TTS_VOICE_MAP={"warm_low":"en-US-Neural2-C","bright_young":"en-US-Neural2-F"}
GOOGLE_TTS_VOICE_MAP={}

# --- Object storage for generated media (§16.6) -------------------------------
# `local` writes to backend/media/ and serves it from Django in DEBUG — dev only.
# `s3` is required outside development (prod.py refuses to boot otherwise):
# containers are ephemeral, so local disk would lose a child's illustrations on
# every restart.
MEDIA_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
# Set for a non-AWS S3-compatible bucket (Cloudflare R2, Backblaze B2, MinIO).
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# The CDN hostname in front of the bucket. Media URLs are built from it, so they
# carry no signature and cache at the edge forever. Empty = serve via storage.
MEDIA_CDN_BASE_URL=

# Creating a companion fans out into six image calls plus a voice call. A family
# does that once per child (§16.6).
THROTTLE_COMPANION=20/hour
