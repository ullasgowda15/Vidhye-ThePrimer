# ─────────────────────────────────────────────────────────────
# The Primer — .gitignore  (Django + DRF + Celery + React/Vite)
# ─────────────────────────────────────────────────────────────

# ===== Secrets & environment (NEVER commit) =====
.env
.env.*
!.env.example
*.pem
*.key
secrets/
backend/config/settings/local.py

# ===== Python / Django =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# NOTE: these Python build artifacts are anchored to backend/ on purpose.
# A bare `build/` / `dist/` would also match docs/Build/ on case-insensitive
# filesystems (Windows/macOS) and silently untrack your build briefs.
/backend/build/
develop-eggs/
/backend/dist/
downloads/
eggs/
.eggs/
# NOTE: anchored to backend/ on purpose. A bare `lib/` would also match
# frontend/src/lib/ (the generated API client) and silently untrack it.
/backend/lib/
/backend/lib64/
/backend/parts/
sdist/
/backend/var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Django runtime
*.log
*.pot
local_settings.py
db.sqlite3
db.sqlite3-journal
# NOTE: user-uploaded media is anchored too — a bare `media/` would match the
# backend/apps/media/ Django app and untrack real source code.
/backend/media/
/backend/staticfiles/
staticfiles/
static_root/

# Django migrations: KEEP these in git (they are source of truth for the schema).
# Do NOT ignore migrations/*.py — they must be committed.

# ===== Celery =====
celerybeat-schedule
celerybeat.pid
*.pid

# ===== Testing / coverage / type-check caches =====
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.hypothesis/

# ===== Node / React / Vite (frontend build tooling only) =====
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
frontend/stats.html
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ===== Docker =====
# (compose files & Dockerfiles ARE committed; only ignore local overrides/volumes)
docker-compose.override.yml
.docker/
pgdata/
*.pgdata

# ===== Editors / OS =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ===== Misc / local artifacts =====
tmp/
.tmp/
*.bak
export.zip

# ===== Safety net: never ignore documentation =====
# docs/ (PRODUCT.md + Build/ + Review/) must always be tracked, even if a
# generic rule above happens to match a folder name like Build/ or dist/.
!docs/
!docs/**

